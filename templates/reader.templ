package templates

import (
	"strconv"
	"strings"
)

// ── local helpers ────────────────────────────────────────────────
// These live here rather than in helpers.go because nothing outside
// the reader needs them, and helpers.go is owned elsewhere.

// readerStripTags removes anything between angle brackets. It is deliberately
// crude: it is only ever used to *compare* two pieces of text, never to
// render, so a mis-parse costs us a duplicated lead paragraph and
// nothing more. It is NOT a sanitiser — see the note on Item.Body below.
func readerStripTags(s string) string {
	var b strings.Builder
	b.Grow(len(s))
	depth := 0
	for _, r := range s {
		switch r {
		case '<':
			depth++
		case '>':
			if depth > 0 {
				depth--
			}
		default:
			if depth == 0 {
				b.WriteRune(r)
			}
		}
	}
	return b.String()
}

func readerNormalise(s string) string {
	return strings.ToLower(strings.Join(strings.Fields(s), " "))
}

// readerAbstractEchoes reports whether the feed's summary is simply the
// opening of the extracted article. Most feeds set <description> to the
// first paragraph, so rendering both makes every article repeat itself
// before it starts. When they differ the abstract is genuine editorial
// and worth showing as a lead.
func readerAbstractEchoes(abstract, body string) bool {
	if abstract == "" || body == "" {
		return false
	}
	a := strings.Trim(readerNormalise(readerStripTags(abstract)), " .…")
	if a == "" {
		return false
	}
	return strings.HasPrefix(readerNormalise(readerStripTags(body)), a)
}

// readerOriginalURL is the article's own address, falling back to the feed's
// when the item carries no link (some feeds omit <link> on every entry).
func readerOriginalURL(data ReaderData) string {
	if data.Item != nil && data.Item.Link != "" {
		return data.Item.Link
	}
	if data.Feed != nil {
		return data.Feed.URL
	}
	return ""
}

// readerSourceLabel drops the scheme so the byline reads as a source rather
// than as a URL. It does no truncation on purpose: Truncate/TruncateURL
// in helpers.go slice by byte, which splits multi-byte runes and emits
// invalid UTF-8. CSS text-overflow does the same job correctly and
// adapts to the pane width.
func readerSourceLabel(u string) string {
	s := strings.TrimPrefix(u, "https://")
	s = strings.TrimPrefix(s, "http://")
	return strings.TrimSuffix(s, "/")
}

func readerPressed(b bool) string {
	return strconv.FormatBool(b)
}

// ── components ───────────────────────────────────────────────────
templ Reader(data ReaderData) {
	if data.Item == nil {
		<section class="reader" id="reader">
			@readerEmpty()
		</section>
	} else {
		@readerContent(data)
	}
}

templ readerContent(data ReaderData) {
	<section class="reader" id="reader">
		<header class="reader-actions">
			<div class="ra-side">
				<!-- only reachable below 960px, where the reader overlays the list -->
				<button
					type="button"
					class="btn-icon reader-back"
					onclick="showPane('list')"
					aria-label="back to the item list"
				>
					<i class="arw arw-rev" aria-hidden="true"></i>
				</button>
				if data.Feed != nil {
					<span class="eyebrow no-lower ra-feed" title={ data.Feed.Title }>{ data.Feed.Title }</span>
				}
			</div>
			<div class="ra-side ra-end">
				<button
					type="button"
					class="btn-icon reader-toggle"
					aria-label="star"
					aria-pressed={ readerPressed(data.Item.Starred) }
					hx-post={ "/items/" + data.Item.ID + "/star" }
					hx-target="#reader"
					hx-swap="outerHTML"
				>
					<svg class="ic ic-star" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 3l2.7 5.7 6.1.9-4.4 4.4 1.1 6.2-5.5-3-5.5 3 1.1-6.2L3.2 9.6l6.1-.9z"></path>
					</svg>
				</button>
				<button
					type="button"
					class="btn-icon reader-toggle"
					aria-label="read"
					aria-pressed={ readerPressed(data.Item.Read) }
					hx-post={ "/items/" + data.Item.ID + "/toggle-read" }
					hx-target="#reader"
					hx-swap="outerHTML"
				>
					<svg class="ic ic-read" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<circle cx="12" cy="12" r="6.5"></circle>
					</svg>
				</button>
				// Re-pull and re-extract this one article. Extraction fails
				// quietly and often — a paywall, a JS-rendered page, a feed
				// that only carries summaries — and until now the only
				// recourse was waiting for a refresh cycle that deliberately
				// skips items it already has. The spinner state comes from
				// htmx's own request class, so it cannot desync.
				<button
					type="button"
					class="btn-icon reader-refetch"
					aria-label="re-fetch this article"
					title="re-fetch this article"
					hx-post={ "/items/" + data.Item.ID + "/refetch" }
					hx-target="#reader"
					hx-swap="outerHTML"
					hx-indicator="#progress-bar, .reader-refetch"
				>
					<svg class="ic ic-refetch" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
						<path d="M20 12a8 8 0 1 1-2.34-5.66"></path>
						<polyline points="20 4 20 9 15 9"></polyline>
					</svg>
				</button>
				if readerOriginalURL(data) != "" {
					<a
						class="btn btn-sm reader-original"
						href={ templ.SafeURL(readerOriginalURL(data)) }
						target="_blank"
						rel="noopener noreferrer"
					>
						@readerIconExternal()
						<span>open original</span>
						<span class="visually-hidden">(opens in a new tab)</span>
					</a>
				}
			</div>
			<!-- scaled by the read-progress custom property, which app.js writes on scroll -->
			<div class="read-progress" aria-hidden="true"></div>
		</header>
		<div class="reader-inner">
			<div class="reader-head">
				<dl class="reader-meta">
					if data.Feed != nil && data.Feed.Title != "" {
						<div class="rm-pair">
							<dt>feed</dt>
							<dd class="no-lower">{ data.Feed.Title }</dd>
						</div>
					}
					if data.Item.Date != "" {
						<div class="rm-pair">
							<dt>published</dt>
							<dd><time datetime={ data.Item.Date }>{ data.Item.Date }</time></dd>
						</div>
					}
					if data.Item.Minutes > 0 {
						<div class="rm-pair">
							<dt>read</dt>
							<dd class="tnum">{ strconv.Itoa(data.Item.Minutes) } min</dd>
						</div>
					}
					if data.Item.Folder != "" {
						<div class="rm-pair">
							<dt>folder</dt>
							<dd>{ data.Item.Folder }</dd>
						</div>
					}
					if data.Item.Tag != "" {
						<div class="rm-pair">
							<dt>tag</dt>
							<dd>{ data.Item.Tag }</dd>
						</div>
					}
				</dl>
				<h1 class="reader-title no-lower">{ data.Item.Title }</h1>
				if data.Item.Authors != "" || data.Feed != nil {
					<p class="reader-byline">
						if data.Item.Authors != "" {
							<span class="no-lower">{ data.Item.Authors }</span>
						}
						if data.Feed != nil && data.Feed.URL != "" {
							<span class="rb-sep" aria-hidden="true"></span>
							<a
								class="reader-source no-lower"
								href={ templ.SafeURL(data.Feed.URL) }
								target="_blank"
								rel="noopener noreferrer"
							>{ readerSourceLabel(data.Feed.URL) }</a>
						}
					</p>
				}
				if data.Item.Abstract != "" && !readerAbstractEchoes(data.Item.Abstract, data.Item.Body) {
					<p class="reader-lead no-lower">{ data.Item.Abstract }</p>
				}
			</div>
			if data.Item.Body != "" {
				<article class="prose">
					@templ.Raw(data.Item.Body)
				</article>
			} else {
				@readerNoBody(readerOriginalURL(data))
			}
			@readerNav(data.PrevID, data.NextID)
		</div>
	</section>
}

// readerNoBody replaces what used to be placeholderBody(): ~250 words of
// invented article prose that shipped to real readers whenever the
// extractor came back empty. Fabricated text presented as the article is
// worse than no text, so this states the truth and offers the original.
templ readerNoBody(href string) {
	<div class="reader-nobody">
		<div class="empty-state">
			<div class="es-mark" aria-hidden="true"><i></i><i></i><i></i></div>
			<p class="es-title">no article text</p>
			<p class="es-hint">extraction came back empty, or this feed publishes headlines only. the full piece is on the publisher's site.</p>
			if href != "" {
				<a class="btn btn-sm" href={ templ.SafeURL(href) } target="_blank" rel="noopener noreferrer">
					@readerIconExternal()
					<span>open original</span>
					<span class="visually-hidden">(opens in a new tab)</span>
				</a>
			}
		</div>
	</div>
}

templ readerNav(prevID string, nextID string) {
	<nav class="reader-nav" aria-label="article">
		if prevID != "" {
			<a
				class="rn-link rn-prev"
				href={ templ.SafeURL("/items/" + prevID) }
				hx-get={ "/items/" + prevID }
				hx-target="#reader"
				hx-swap="outerHTML"
			>
				<i class="arw arw-rev" aria-hidden="true"></i>
				<span>previous</span>
			</a>
		} else {
			<span class="rn-link rn-prev is-disabled" aria-disabled="true">
				<i class="arw arw-rev" aria-hidden="true"></i>
				<span>previous</span>
			</span>
		}
		if nextID != "" {
			<a
				class="rn-link rn-next"
				href={ templ.SafeURL("/items/" + nextID) }
				hx-get={ "/items/" + nextID }
				hx-target="#reader"
				hx-swap="outerHTML"
			>
				<span>next</span>
				<i class="arw" aria-hidden="true"></i>
			</a>
		} else {
			<span class="rn-link rn-next is-disabled" aria-disabled="true">
				<span>next</span>
				<i class="arw" aria-hidden="true"></i>
			</span>
		}
	</nav>
}

templ readerEmpty() {
	<div class="reader-empty">
		<div class="empty-state">
			<div class="es-mark" aria-hidden="true"><i></i><i></i><i></i></div>
			<p class="es-title">pick an item</p>
			<p class="es-hint re-keys">
				<span class="re-key"><span class="kbd">j</span> <span class="kbd">k</span> navigate</span>
				<span class="re-key"><span class="kbd">o</span> open</span>
				<span class="re-key"><span class="kbd">s</span> star</span>
			</p>
		</div>
	</div>
}

templ readerIconExternal() {
	<svg class="ic" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
		<path d="M14 4h6v6"></path>
		<path d="M20 4l-9 9"></path>
		<path d="M18 14.5V19.5H4.5V6h5"></path>
	</svg>
}
