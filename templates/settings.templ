package templates

templ Settings(data SettingsData) {
	<main class="settings-page" id="main">
		<div class="settings-scroll scroll-y">
			<div class="settings-doc">
				<header class="settings-head">
					<p class="eyebrow">settings</p>
					<h1 class="pane-title">settings.</h1>
					<p class="pane-lead">
						no account. no sync. your reading data lives in your <span class="no-lower">{ data.DatabaseDriver }</span> database.
					</p>
				</header>
				<!-- ══ appearance — the only two settings this page can actually change ══ -->
				<section class="s-section" aria-labelledby="s-appearance-h">
					<div class="s-section-head">
						<p class="eyebrow">01 / appearance</p>
						<h2 class="s-section-title" id="s-appearance-h">appearance</h2>
					</div>
					<p class="s-section-note">these two are live. they are stored in this browser only — nothing is sent to the server.</p>
					<div class="s-controls">
						<div class="s-control">
							<span class="s-control-label" id="s-theme-label">colour scheme</span>
							<div class="seg-control" role="group" aria-labelledby="s-theme-label">
								<button type="button" data-theme-opt="light" aria-pressed="false">light</button>
								<button type="button" data-theme-opt="dark" aria-pressed="false">dark</button>
							</div>
						</div>
						<div class="s-control">
							<span class="s-control-label" id="s-density-label">list row height</span>
							<div class="seg-control" role="group" aria-labelledby="s-density-label">
								<button type="button" data-density-opt="tight" aria-pressed="false">tight</button>
								<button type="button" data-density-opt="default" aria-pressed="false">default</button>
								<button type="button" data-density-opt="loose" aria-pressed="false">loose</button>
							</div>
						</div>
					</div>
				</section>
				<!-- ══ server configuration — read-only. every value here is an env var read at boot. ══ -->
				<section class="s-section" aria-labelledby="s-server-h">
					<div class="s-section-head">
						<p class="eyebrow">02 / server configuration</p>
						<h2 class="s-section-title" id="s-server-h">server configuration</h2>
					</div>
					<p class="s-section-note">read at boot from the environment. change the variable and restart the process.</p>
					<dl class="s-defs">
						<div class="s-def">
							<dt class="s-def-term">refresh cadence</dt>
							<dd class="s-def-body">
								<span class="s-def-value no-lower">{ data.RefreshInterval }</span>
								<code class="s-def-env no-lower">REFRESH_INTERVAL</code>
								<span class="s-def-note">how often every feed is re-fetched in the background.</span>
							</dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">mark read on</dt>
							<dd class="s-def-body">
								<span class="s-def-value no-lower">{ data.MarkReadOn }</span>
								<code class="s-def-env no-lower">MARK_READ_ON</code>
								<span class="s-def-note">when an item flips to read — on <code class="no-lower">scroll</code>, on <code class="no-lower">open</code>, or only <code class="no-lower">manual</code>ly.</span>
							</dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">retention</dt>
							<dd class="s-def-body">
								<span class="s-def-value no-lower">{ data.Retention }</span>
								<code class="s-def-env no-lower">RETENTION</code>
								<span class="s-def-note">how long read items are kept before they are pruned.</span>
							</dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">default density</dt>
							<dd class="s-def-body">
								<span class="s-def-value no-lower">{ data.Density }</span>
								<code class="s-def-env no-lower">DENSITY</code>
								<span class="s-def-note">the starting row height for a browser that has not picked one. the appearance control above overrides it locally.</span>
							</dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">database</dt>
							<dd class="s-def-body">
								<span class="s-def-value no-lower">{ data.DatabaseDriver }</span>
								<code class="s-def-env no-lower">DATABASE_DRIVER</code>
								<span class="s-def-note">connected to <span class="no-lower">{ data.DatabaseInfo }</span>.</span>
							</dd>
						</div>
					</dl>
				</section>
				<!-- ══ build — what to quote in a bug report ══ -->
				<section class="s-section" aria-labelledby="s-build-h">
					<div class="s-section-head">
						<p class="eyebrow">03 / build</p>
						<h2 class="s-section-title" id="s-build-h">build</h2>
					</div>
					<p class="s-section-note">quote this when you file a bug.</p>
					<dl class="s-defs s-defs-compact">
						<div class="s-def">
							<dt class="s-def-term">binary</dt>
							<dd class="s-def-body"><span class="s-def-value no-lower">kontrolplane-feed</span><span class="s-def-note">go</span></dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">router</dt>
							<dd class="s-def-body"><span class="s-def-value no-lower">net/http.ServeMux</span></dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">templates</dt>
							<dd class="s-def-body"><span class="s-def-value no-lower">a-h/templ</span></dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">parser</dt>
							<dd class="s-def-body"><span class="s-def-value no-lower">mmcdole/gofeed</span></dd>
						</div>
						<div class="s-def">
							<dt class="s-def-term">front end</dt>
							<dd class="s-def-body"><span class="s-def-value no-lower">htmx 2</span><span class="s-def-note">no build step.</span></dd>
						</div>
					</dl>
				</section>
				<!-- ══ keyboard — only the keys app.js actually binds. two tables, split on what the keys act on. ══ -->
				<section class="s-section" aria-labelledby="s-keys-h">
					<div class="s-section-head">
						<p class="eyebrow">04 / keyboard</p>
						<h2 class="s-section-title" id="s-keys-h">keyboard</h2>
					</div>
					<p class="s-section-note">inactive while a text field has focus. modifier combinations are left to the browser.</p>
					<div class="s-keys-grid">
						<table class="s-keys">
							<caption class="s-keys-cap">reading</caption>
							<thead>
								<tr>
									<th scope="col">key</th>
									<th scope="col">action</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row"><kbd class="kbd">j</kbd> <kbd class="kbd">k</kbd></th>
									<td>next / previous item</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">o</kbd> <kbd class="kbd">↵</kbd></th>
									<td>open the selected item in the reader</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">s</kbd></th>
									<td>star / unstar the open item</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">m</kbd></th>
									<td>mark the open item read / unread</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">g</kbd> <kbd class="kbd">g</kbd></th>
									<td>jump to the top of the list</td>
								</tr>
							</tbody>
						</table>
						<table class="s-keys">
							<caption class="s-keys-cap">app</caption>
							<thead>
								<tr>
									<th scope="col">key</th>
									<th scope="col">action</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th scope="row"><kbd class="kbd">/</kbd></th>
									<td>focus search</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">n</kbd></th>
									<td>add a feed</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">1</kbd></th>
									<td>show / hide the sidebar</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">2</kbd></th>
									<td>show / hide the item list</td>
								</tr>
								<tr>
									<th scope="row"><kbd class="kbd">esc</kbd></th>
									<td>close the open dialog, drawer, or leave a text field</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
				<!-- ══ data — opml in and out. the only two routes that move feeds in bulk. ══ -->
				<section class="s-section" aria-labelledby="s-data-h">
					<div class="s-section-head">
						<p class="eyebrow">05 / data</p>
						<h2 class="s-section-title" id="s-data-h">data</h2>
					</div>
					<p class="s-section-note">opml is the portable format every reader speaks. export it, take it elsewhere, nothing is locked in here.</p>
					<div class="s-data-actions">
						<label class="btn s-file" for="opml-file">
							import opml
							<input
								id="opml-file"
								class="s-file-input"
								type="file"
								name="file"
								accept=".opml,.xml"
								hx-post="/import/opml"
								hx-encoding="multipart/form-data"
								hx-trigger="change"
								hx-swap="none"
								hx-indicator="#progress-bar"
								hx-on::after-request="var r=document.getElementById('import-result');var ok=event.detail.successful;r.dataset.state=ok?'ok':'err';r.textContent=ok?'import accepted — reloading with your new feeds.':'import failed — that file was not readable opml.';this.value='';"
							/>
						</label>
						<a class="btn" href="/export/opml" download="feeds.opml">
							export opml
							<i class="arw"></i>
						</a>
					</div>
					<p class="import-result" id="import-result" role="status" aria-live="polite"></p>
				</section>
			</div>
		</div>
	</main>
	<section id="reader" class="pane-hidden" hx-swap-oob="outerHTML"></section>
}
