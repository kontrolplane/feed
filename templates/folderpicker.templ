package templates

import (
	"fmt"
	"sync/atomic"

	"github.com/kontrolplane/feed/internal/store"
)

// Two pickers can be on the page at once (the subscribe modal and an
// open ManageFeedEdit card), and a <label for> only works if the id it
// points at is unique in the document. A per-render sequence is the
// cheapest way to guarantee that without threading an id through the
// two call sites — and without it, clicking either label focuses the
// wrong select.
var folderPickerSeq atomic.Uint64

func folderPickerIDs() (string, string) {
	n := folderPickerSeq.Add(1)
	return fmt.Sprintf("folder-picker-%d", n), fmt.Sprintf("folder-picker-new-%d", n)
}

// FolderPicker owns its own label — do not add another one at the call
// site. The select is always named "folder"; choosing the "__new__"
// option reveals the "new_folder" text input. Both names are read by
// resolveFolder() in internal/handler.
//
// The reveal used to be a 200-character inline onchange string poking
// at style.display. It is now the plain `hidden` attribute toggled by
// app.js, bound by the `.folder-picker select` selector.
templ FolderPicker(folders []store.Folder, selected string) {
	{{ selectID, newID := folderPickerIDs() }}
	// with no folders at all the only option is "+ new folder", so the
	// name input opens already revealed. Previously this case rendered a
	// select whose sole option was __new__ over a hidden input, and
	// subscribing silently created a folder literally called "__new__".
	{{ isNew := selected == "__new__" || len(folders) == 0 }}
	<div class="folder-picker">
		<label class="field-label" for={ selectID }>place in folder</label>
		<select id={ selectID } class="field" name="folder">
			for _, f := range folders {
				<option class="no-lower" value={ f.ID } selected?={ f.ID == selected }>{ f.Label }</option>
			}
			<option value="__new__" selected?={ isNew }>+ new folder…</option>
		</select>
		<div class="folder-picker-new" hidden?={ !isNew }>
			<label class="field-label" for={ newID }>new folder name</label>
			<input
				id={ newID }
				class="field"
				type="text"
				name="new_folder"
				placeholder="e.g. tech"
				autocomplete="off"
				required?={ isNew }
			/>
		</div>
	</div>
}
